@using System.Linq
@model FakeStore.WebApp.Models.OrderTabCardsViewModel

@if (Model.Orders is null || !Model.Orders.Any())
{
    <div class="col-12">
        <div class="alert alert-secondary mb-0">No orders found.</div>
    </div>
}
else
{

    @foreach (var order in Model.Orders)
    {
        var orderItems = order.items ?? [];

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Order #@order.order_id</span>
                    <span class="badge bg-white border text-black fw-bold">@order.status</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <p class="text-muted small mb-1">User Id</p>
                            <p class="mb-0 fw-semibold">@order.user_id</p>
                        </div>
                        <div class="col-12 col-md-4">
                            <p class="text-muted small mb-1">Total Price</p>
                            <p class="mb-0 fw-semibold">@order.total_price</p>
                        </div>
                        <div class="col-12 col-md-4">
                            <p class="text-muted small mb-1">Items</p>
                            <p class="mb-0 fw-semibold">@orderItems.Count</p>
                        </div>
                    </div>

                    @if (orderItems.Count == 0)
                    {
                        <p class="mb-0 text-muted">No items found in this order.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in orderItems)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Product #@item.product_id</span>
                                    <span class="badge bg-white border text-black fw-bold">Qty: @item.quantity</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
                @if (Model.HasFullAccessRole)
                {
                    <div class="card-footer d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <form asp-controller="Order"
                              asp-action="UpdateStatus"
                              method="post"
                              class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="hidden" name="orderId" value="@order.order_id" />
                            <label for="order-status-@order.order_id" class="small text-muted mb-0">Status</label>
                            <input id="order-status-@order.order_id"
                                   type="text"
                                   class="form-control form-control-sm"
                                   style="width: 180px;"
                                   name="status"
                                   value="@order.status"
                                   maxlength="50"
                                   required />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Update status</button>
                        </form>
                        <form asp-controller="Order" asp-action="DeleteOrder" method="post" class="d-inline">
                            <input type="hidden" name="orderId" value="@order.order_id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete order</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}
