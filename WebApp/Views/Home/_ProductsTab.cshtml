@using System
@model FakeStore.WebApp.Models.HomePageViewModel
@{
    var isActive = string.Equals(Model.ActiveTab, "products", StringComparison.OrdinalIgnoreCase);
}

<div class="tab-pane fade @(isActive ? "show active" : string.Empty)" id="products-pane" role="tabpanel" aria-labelledby="products-tab">
    @if (Model.HasFullAccessRole && !Model.IsPublicApi)
    {
        <div class="d-flex justify-content-end mb-3">
            <a class="btn btn-primary"
               asp-controller="Product"
               asp-action="Create">
                Add Product
            </a>
        </div>
    }

    <div id="products-loading" class="home-tab-loading d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mb-0 mt-2 text-muted">Loading products...</p>
    </div>
    <div id="products-error" class="alert alert-danger d-none mt-3 mb-0"></div>
    <div id="products-list" class="row g-3 mt-1"></div>
</div>
