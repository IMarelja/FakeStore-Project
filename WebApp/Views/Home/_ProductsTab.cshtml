@model FakeStore.WebApp.Models.HomePageViewModel


<!-- Setting default set "show active" or undefault by removing it -->
<div class="tab-pane fade show active" id="products-pane" role="tabpanel" aria-labelledby="products-tab">
    @if (Model.HasFullAccessRole)
    {
        <div class="d-flex justify-content-end mb-3">
            <a class="btn btn-primary"
               asp-controller="Home"
               asp-action="ComingSoon"
               asp-route-itemType="Product"
               asp-route-featureAction="Add">
                Add Product
            </a>
        </div>
    }

    <div id="products-loading" class="home-tab-loading d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mb-0 mt-2 text-muted">Loading products...</p>
    </div>
    <div id="products-error" class="alert alert-danger d-none mt-3 mb-0"></div>
    <div id="products-list" class="row g-3 mt-1"></div>

    @if (Model.HasFullAccessRole)
    {
        <div class="d-flex justify-content-end mt-3">
            <a class="btn btn-outline-primary"
               asp-controller="Home"
               asp-action="ComingSoon"
               asp-route-itemType="Product"
               asp-route-featureAction="Add">
                Add Product
            </a>
        </div>
    }
</div>
