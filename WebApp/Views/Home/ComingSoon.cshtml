@model FakeStore.WebApp.Models.ComingSoonPageViewModel
@{
    ViewData["Title"] = "Coming Soon";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h1 class="h3 mb-3">@Model.FeatureAction @Model.ItemType</h1>
                <p class="text-muted mb-1">Coming soon</p>
                @if (!string.IsNullOrWhiteSpace(Model.ItemId))
                {
                    <p class="small text-muted mb-4">Reference ID: @Model.ItemId</p>
                }
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
            </div>
        </div>
    </div>
</div>
