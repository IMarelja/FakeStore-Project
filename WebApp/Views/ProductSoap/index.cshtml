@model FakeStore.WebApp.Models.ProductSoapViewModel
@{
    ViewData["Title"] = "SOAP Product Search";
    var products = Model.searchResult?.Products ?? [];
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <h1 class="h3 mb-3">SOAP Product Search</h1>

        <form asp-controller="ProductSoap" asp-action="Index" method="post" class="card shadow-sm p-3 mb-3">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label asp-for="searchedTerm" class="form-label">Search term</label>
                    <input asp-for="searchedTerm" class="form-control" placeholder="e.g. phone, laptop..." />
                    <span asp-validation-for="searchedTerm" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg-3">
                    <label asp-for="selectedMinPrice" class="form-label">Min price</label>
                    <input asp-for="selectedMinPrice" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="selectedMinPrice" class="text-danger"></span>
                </div>
                <div class="col-6 col-lg-3">
                    <label asp-for="selectedMaxPrice" class="form-label">Max price</label>
                    <input asp-for="selectedMaxPrice" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="selectedMaxPrice" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-controller="ProductSoap" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.errorMessage))
        {
            <div class="alert alert-danger">@Model.errorMessage</div>
        }

        @if (Model.found)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="mb-3">
                        Found <strong>@(Model.searchResult?.Count ?? products.Length)</strong> product(s).
                    </p>

                    @if (products.Length == 0)
                    {
                        <div class="alert alert-secondary mb-0">No products matched your filters.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Brand</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Rating</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in products)
                                    {
                                        <tr>
                                            <td>@product.Id</td>
                                            <td>@product.Name</td>
                                            <td>@product.Brand</td>
                                            <td>@product.Category</td>
                                            <td>@product.Price.ToString("0.##")</td>
                                            <td>@product.Rating.ToString("0.##")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
