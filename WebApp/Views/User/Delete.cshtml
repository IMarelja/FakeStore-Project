@model FakeStore.WebApp.Models.UserDeletePageViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Delete User</h1>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }

        @if (Model.Deleted)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        }
        else if (Model.User is not null)
        {
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <p class="mb-2"><strong>User ID:</strong> @Model.User.user_id</p>
                    <p class="mb-2"><strong>Username:</strong> @Model.User.username</p>
                    <p class="mb-2"><strong>Email:</strong> @Model.User.email</p>
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        Are you sure you want to delete this user?
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-controller="User" asp-action="DeleteConfirmed" asp-route-id="@Model.User.user_id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Yes, delete</button>
                    </form>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        }
    </div>
</div>
