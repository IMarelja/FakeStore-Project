@inject FakeStore.WebApp.Configuration.ApiRuntimeMode ApiRuntimeMode
@{
    var selectedApi = ApiRuntimeMode.Selected;
    var isCustomApi = selectedApi.Equals("Custom", StringComparison.OrdinalIgnoreCase);
    var apiBadgeClass = isCustomApi ? "api-mode-pill custom" : "api-mode-pill public";
    var apiBadgeText = isCustomApi ? "Custom API" : "Public API";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FakeStore.WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FakeStore.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FakeStore.WebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Weather" asp-action="Index">Weather</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="ProductSoap" asp-action="Index">SOAP Search</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (isCustomApi)
                        {
                            <ul class="navbar-nav flex-row mb-0 me-1">
                                @if (User?.Identity?.IsAuthenticated ?? false)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark px-2" asp-controller="Profile" asp-action="Index">Profile</a>
                                    </li>
                                    <li class="nav-item">
                                        <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="nav-link text-dark px-2 border-0 bg-transparent">Logout</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark px-2" asp-controller="Login" asp-action="Index">Login</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark px-2" asp-controller="Register" asp-action="Index">Register</a>
                                    </li>
                                }
                            </ul>
                        }

                        <a class="@apiBadgeClass" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@apiBadgeText">
                            <span class="logo-circle" aria-hidden="true">
                                @if (isCustomApi)
                                {
                                    <img class="api-mode-logo" src="~/images/graphql.webp" alt="GraphQL logo" />
                                }
                                else
                                {
                                    <img class="api-mode-logo" src="~/images/beeceptor.png" alt="Beeceptor logo" />
                                }
                            </span>
                            <span>@apiBadgeText</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <!--&copy; 2026 - FakeStore.WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>-->
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
