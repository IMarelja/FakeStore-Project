@model FakeStore.WebApp.Models.ProductDeletePageViewModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        <h1 class="h3 mb-3">Delete Product</h1>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }

        @if (Model.Deleted)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        }
        else if (Model.Product is not null)
        {
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <p class="mb-2"><strong>Product:</strong> @Model.Product.name</p>
                    <p class="mb-2"><strong>ID:</strong> @Model.Product.product_id</p>
                    <p class="mb-2"><strong>Price:</strong> @Model.Product.price</p>
                    <img src="@Model.Product.image"
                         alt="@Model.Product.name"
                         class="img-fluid border rounded"
                         style="max-height: 200px; object-fit: contain;"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/image-not-found.jpg")';" />

                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        Are you sure you want to delete this product?
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-controller="Product" asp-action="DeleteConfirmed" asp-route-id="@Model.Product.product_id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Yes, delete</button>
                    </form>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        }
    </div>
</div>
