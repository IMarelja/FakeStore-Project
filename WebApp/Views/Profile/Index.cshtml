@model FakeStore.WebApp.Models.ProfilePageViewModel
@{
    ViewData["Title"] = "Profile";
    var roles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value).ToArray();
    var canManageProfile = User.IsInRole("full access");
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h3 mb-3">User Profile</h1>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }

        <div class="card p-3 shadow-sm mb-3">
            <h2 class="h5">Current Information</h2>
            <p><strong>User ID:</strong> @(Model.CurrentUser?.user_id.ToString() ?? "-")</p>
            <p><strong>Username:</strong> @(Model.CurrentUser?.username ?? "-")</p>
            <p><strong>Email:</strong> @(Model.CurrentUser?.email ?? "-")</p>
            <p class="mb-0"><strong>Roles:</strong> @(roles.Length > 0 ? string.Join(", ", roles) : "-")</p>
        </div>

        <div class="card p-3 shadow-sm mb-3">
            <h2 class="h5">Update Profile</h2>
            @if (!canManageProfile)
            {
                <p class="mb-0 text-muted">Your role can view profile data, but cannot edit or delete account details.</p>
            }
            else
            {
                <form asp-controller="Profile" asp-action="Update" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input id="username" name="username" value="@Model.UpdateRequest.Username" class="form-control" autocomplete="username" />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input id="email" name="email" value="@Model.UpdateRequest.Email" type="email" class="form-control" autocomplete="email" />
                    </div>

                    <div class="mb-0">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <input id="password" name="password" value="@Model.UpdateRequest.Password" type="password" class="form-control" autocomplete="new-password" />
                            <button id="toggleProfilePassword" type="button" class="btn btn-outline-secondary" aria-pressed="false">
                                Show
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
                </form>
            }
        </div>

        @if (canManageProfile)
        {
            <div class="card p-3 shadow-sm border-danger">
                <h2 class="h5 text-danger">Delete Account</h2>
                <p class="mb-3">This action permanently deletes your account.</p>
                <form asp-controller="Profile" asp-action="DeleteMe" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete My Account</button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const passwordInput = document.getElementById("password");
            const toggleButton = document.getElementById("toggleProfilePassword");
            if (!passwordInput || !toggleButton) return;

            toggleButton.addEventListener("click", () => {
                const isHidden = passwordInput.type === "password";
                passwordInput.type = isHidden ? "text" : "password";
                toggleButton.textContent = isHidden ? "Hide" : "Show";
                toggleButton.setAttribute("aria-pressed", isHidden ? "true" : "false");
            });
        })();
    </script>
}
